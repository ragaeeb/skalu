{
    "include-component-in-tag": true,
    "packages": {
        ".": {
            "release-type": "node",
            "component": "app",
            "package-name": "skalu",
            "exclude-paths": [
                "packages/engine/**"
            ],
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                {
                    "type": "json",
                    "path": "apps/web/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "apps/worker/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/contracts/package.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "packages/engine": {
            "release-type": "python",
            "component": "engine",
            "package-name": "skalu-engine",
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                "server.py",
                "skalu.py"
            ]
        }
    },
    "separate-pull-requests": false
}
