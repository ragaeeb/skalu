{
    "compilerOptions": {
        "target": "esnext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "types": ["bun-types"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "tests", "e2e"]
}
